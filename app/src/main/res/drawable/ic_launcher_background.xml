<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Fond de l'icône : bleu nuit en dégradé + halo lumineux derrière le temple -->

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:startColor="#1A4C7C"
                android:endColor="#0A1E35" />
        </aapt:attr>
    </path>

    <!-- Halo doux centré légèrement au-dessus du centre -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="48"
                android:gradientRadius="46"
                android:startColor="#552F6FA8"
                android:endColor="#002F6FA8" />
        </aapt:attr>
    </path>
</vector>
